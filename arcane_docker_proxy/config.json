{
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "services",
  "boot": "auto",
  "stage": "experimental",
  "legacy": true,
  "init": true,
  "name": "Arcane Read-only Docker Proxy",
  "version": "1.13.1-1",
  "slug": "arcane_docker_proxy",
  "description": "Allowlisted monitoring access to Docker for the Arcane Edge Agent.",
  "docker_api": true,
  "options": {
    "SP_ALLOWFROM": "127.0.0.1/32"
  },
  "schema": {
    "SP_ALLOWFROM": "str"
  },
  "environment": {
    "SP_LISTENIP": "0.0.0.0",
    "SP_ALLOW_GET": "(/v[0-9]+\\.[0-9]+)?/(_ping|version|info|events|system/df|containers/json|containers/[a-zA-Z0-9_.-]+/(json|stats|logs|top)|images/json|images/[a-zA-Z0-9_.:/-]+/json|networks|networks/[a-zA-Z0-9_.-]+|volumes|volumes/[a-zA-Z0-9_.-]+)",
    "SP_ALLOW_HEAD": "(/v[0-9]+\\.[0-9]+)?/(_ping|version)"
  }
}
